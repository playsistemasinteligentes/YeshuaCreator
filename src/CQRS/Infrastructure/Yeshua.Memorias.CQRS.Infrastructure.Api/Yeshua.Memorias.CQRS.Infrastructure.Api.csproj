<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>false</InvariantGlobalization>
    <YeshuaCommitSha Condition="'$(YeshuaCommitSha)' == ''">$(SourceRevisionId)</YeshuaCommitSha>
    <YeshuaBuildTimestampUtc Condition="'$(YeshuaBuildTimestampUtc)' == ''">UNSET</YeshuaBuildTimestampUtc>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.14" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.5.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Yeshua.Memorias.CQRS.Infrastructure.Shared\Yeshua.Memorias.CQRS.Infrastructure.Shared.csproj" />
    <ProjectReference Include="..\..\Domain\Yeshua.Memorias.CQRS.Domain\Yeshua.Memorias.CQRS.Domain.csproj" />
    <ProjectReference Include="..\..\Application\Yeshua.Memorias.CQRS.Application.Command\Yeshua.Memorias.CQRS.Application.Command.csproj" />
    <ProjectReference Include="..\..\Application\Yeshua.Memorias.CQRS.Application.RepositoryInterfaces\Yeshua.Memorias.CQRS.Application.RepositoryInterfaces.csproj" />
    <ProjectReference Include="..\Yeshua.Memorias.CQRS.Infrastructure.RepositoryRead\Yeshua.Memorias.CQRS.Infrastructure.RepositoryRead.csproj" />
    <ProjectReference Include="..\Yeshua.Memorias.CQRS.Infrastructure.RepositoryWrite\Yeshua.Memorias.CQRS.Infrastructure.RepositoryWrite.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Update="Custon\ExternalConnectors\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>
  <ItemGroup>
    <RuntimeHostConfigurationOption Include="Yeshua.Application" Value="Memorias" />
    <RuntimeHostConfigurationOption Include="Yeshua.Version" Value="$(Version)" />
    <RuntimeHostConfigurationOption Include="Yeshua.CommitSha" Value="$(YeshuaCommitSha)" />
    <RuntimeHostConfigurationOption Include="Yeshua.BuildTimestampUtc" Value="$(YeshuaBuildTimestampUtc)" />
  </ItemGroup>
</Project>