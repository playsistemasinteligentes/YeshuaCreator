{
  "ConnectionStrings": {
    "OperationalIntelligence": ""
  },
  "OperationalIntelligence": {
    "PublicBaseUrl": "https://playsis.com.br/operational/",
    "EnsureDatabase": true,
    "RunMigrations": true,
    "CommandTimeoutSeconds": 60,
    "DefaultMaxDepth": 12,
    "MaximumMaxDepth": 100,
    "DefaultMaxResults": 500,
    "MaximumMaxResults": 5000,
    "CollectorTimeoutSeconds": 30
  },
  "OperationalControl": {
    "Applications": {
      "Clinica": {
        "Production": {
          "DefaultLevel": "Information",
          "DefaultDepth": "D0",
          "Targets": []
        }
      },
      "Fiscal": {
        "Development": {
          "DefaultLevel": "None",
          "DefaultDepth": "D0",
          "Targets": []
        },
        "Homologation": {
          "DefaultLevel": "None",
          "DefaultDepth": "D0",
          "Targets": []
        }
      }
    }
  },
  "Mcp": {
    "Enabled": true,
    "PrivatePort": 5729,
    "LokiBaseUrl": "http://localhost:3100",
    "TempoBaseUrl": "http://localhost:3200",
    "PrometheusBaseUrl": "http://localhost:9090",
    "DefaultLimit": 100,
    "MaxLimit": 1000,
    "TimeoutSeconds": 10,
    "MaxTimeRangeHours": 24,
    "DatabaseQuery": {
      "Enabled": true,
      "MaxRows": 200,
      "CommandTimeoutSeconds": 10,
      "MaxSqlLength": 10000,
      "Connections": {}
    }
  },
  "AgentTasks": {
    "Enabled": false,
    "ChatGptAuthentication": false,
    "CodexHomePath": "/home/agent/.codex",
    "AllowWorkspaceWrite": false,
    "WorkspacePath": "/workspace/YeshuaCreator",
    "RuntimeScript": "/app/agent/codex-task.mjs",
    "MaxPendingMessages": 100,
    "MaxTurnSeconds": 1800
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "ModelContextProtocol": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
