{
  "Version": "1.0",
  "Environment": "Production",
  "Domain": "playsis.com.br",
  "Applications": [
    "Clinica",
    "Fiscal.MDFe"
  ],
  "Resources": [
    {
      "Identity": "sql01",
      "Kind": "DatabaseServer",
      "Image": "mcr.microsoft.com/mssql/server:2022-latest",
      "Applications": [
        "Clinica",
        "Fiscal.MDFe"
      ],
      "Configuration": {
        "Engine": "SqlServer"
      },
      "RuntimeConfiguration": {
        "ACCEPT_EULA": "Y",
        "MSSQL_PID": "Express"
      },
      "Secrets": [
        {
          "Target": "MSSQL_SA_PASSWORD",
          "Secret": "sql01-sa-password"
        }
      ],
      "Persistence": [
        {
          "Name": "sql-data",
          "MountPath": "/var/opt/mssql"
        }
      ],
      "PersistenceBindings": {
        "sql-data": "/root/YeshuaDB/persistent/sql"
      },
      "PublishedPorts": [
        {
          "HostPort": 1433,
          "ContainerPort": 1433
        }
      ]
    },
    {
      "Identity": "clinica-database",
      "Kind": "DatabaseCatalog",
      "Parent": "sql01",
      "Applications": [
        "Clinica"
      ],
      "Configuration": {
        "Catalog": "CLINICA"
      },
      "RuntimeConfiguration": {},
      "Secrets": [],
      "Persistence": [],
      "PersistenceBindings": {},
      "PublishedPorts": []
    },
    {
      "Identity": "redis01",
      "Kind": "Cache",
      "Image": "redis:7-alpine",
      "Applications": [
        "Clinica"
      ],
      "Configuration": {},
      "RuntimeConfiguration": {},
      "Secrets": [],
      "Persistence": [],
      "PersistenceBindings": {},
      "PublishedPorts": [
        {
          "HostPort": 6379,
          "ContainerPort": 6379
        }
      ]
    },
    {
      "Identity": "rabbit01",
      "Kind": "MessageBroker",
      "Image": "rabbitmq:3-management-alpine",
      "Applications": [
        "Clinica"
      ],
      "Configuration": {},
      "RuntimeConfiguration": {},
      "Secrets": [
        {
          "Target": "RABBITMQ_DEFAULT_USER",
          "Secret": "rabbit01-username"
        },
        {
          "Target": "RABBITMQ_DEFAULT_PASS",
          "Secret": "rabbit01-password"
        }
      ],
      "Persistence": [],
      "PersistenceBindings": {},
      "PublishedPorts": [
        {
          "HostPort": 5672,
          "ContainerPort": 5672
        },
        {
          "HostPort": 15672,
          "ContainerPort": 15672
        }
      ]
    },
    {
      "Identity": "storage01",
      "Kind": "Storage",
      "Applications": [
        "Clinica"
      ],
      "Configuration": {},
      "RuntimeConfiguration": {},
      "Secrets": [],
      "Persistence": [
        {
          "Name": "application-storage",
          "MountPath": "/storage"
        }
      ],
      "PersistenceBindings": {
        "application-storage": "/root/YeshuaStorage"
      },
      "PublishedPorts": []
    },
    {
      "Identity": "fiscal-mdfe-database",
      "Kind": "DatabaseCatalog",
      "Parent": "sql01",
      "Applications": [
        "Fiscal.MDFe"
      ],
      "Configuration": {
        "Catalog": "MDFE"
      },
      "RuntimeConfiguration": {},
      "Secrets": [],
      "Persistence": [],
      "PersistenceBindings": {},
      "PublishedPorts": []
    }
  ],
  "Workloads": [
    {
      "Application": "Clinica",
      "Workload": {
        "Name": "api",
        "Identity": "clinica-api",
        "Mode": "Service",
        "Source": {
          "Kind": "Project",
          "ProjectPath": "src/CQRS/Infrastructure/Yeshua.Clinica.CQRS.Infrastructure.Api/Yeshua.Clinica.CQRS.Infrastructure.Api.csproj",
          "BuildContext": ".",
          "Dockerfile": "infra/Clinica/Migration/workloads/api/Dockerfile"
        },
        "Replicas": 1,
        "Requires": [
          "clinica-database",
          "redis01",
          "storage01"
        ],
        "Consumes": [],
        "Produces": [],
        "Configuration": {
          "ASPNETCORE_ENVIRONMENT": "Production",
          "Redis__Host": "redis01",
          "Storage__Providers__Disk__Root": "/storage",
          "Storage__Providers__Disk__BaseUrl": "https://playsis.com.br",
          "Storage__Locations__volatile/ia/transcriptions/input": "Disk",
          "Storage__Locations__volatile/ia/transcriptions/output": "Disk",
          "Storage__Locations__volatile/reports/input": "Disk",
          "Storage__Locations__volatile/reports/output": "Disk",
          "Storage__Locations__persistent/docs/input": "Disk",
          "Storage__Locations__persistent/docs/output": "Disk"
        },
        "Secrets": [
          {
            "Target": "MYCONFIG__READCONECTIONSTRING",
            "Secret": "clinica-database-read-connection"
          },
          {
            "Target": "MYCONFIG__WRITECONECTIONSTRING",
            "Secret": "clinica-database-write-connection"
          }
        ],
        "Ports": [
          {
            "Name": "http",
            "ContainerPort": 7214,
            "Protocol": "Http",
            "Route": "/yapi"
          }
        ],
        "Mounts": [
          {
            "Resource": "storage01",
            "MountPath": "/storage",
            "ReadOnly": false
          }
        ],
        "HealthCheck": {
          "Kind": "Tcp",
          "Port": "http",
          "Command": [],
          "IntervalSeconds": 30,
          "TimeoutSeconds": 5,
          "Retries": 3
        }
      }
    },
    {
      "Application": "Clinica",
      "Workload": {
        "Name": "front",
        "Identity": "clinica-front",
        "Mode": "Service",
        "Source": {
          "Kind": "Project",
          "ProjectPath": "src/CQRS/Infrastructure/Yeshua.Clinica.CQRS.Infrastructure.Front/Yeshua.Clinica.CQRS.Infrastructure.Front.csproj",
          "BuildContext": ".",
          "Dockerfile": "infra/Clinica/Migration/workloads/front/Dockerfile"
        },
        "Replicas": 2,
        "Requires": [
          "clinica-api"
        ],
        "Consumes": [],
        "Produces": [],
        "Configuration": {
          "ASPNETCORE_ENVIRONMENT": "Production"
        },
        "Secrets": [],
        "Ports": [
          {
            "Name": "http",
            "ContainerPort": 8080,
            "Protocol": "Http",
            "Route": "/"
          }
        ],
        "Mounts": [],
        "HealthCheck": {
          "Kind": "Tcp",
          "Port": "http",
          "Command": [],
          "IntervalSeconds": 30,
          "TimeoutSeconds": 5,
          "Retries": 3
        }
      }
    },
    {
      "Application": "Clinica",
      "Workload": {
        "Name": "worker",
        "Identity": "clinica-worker",
        "Mode": "Service",
        "Source": {
          "Kind": "Project",
          "ProjectPath": "src/CQRS/Infrastructure/Yeshua.Clinica.CQRS.Infrastructure.Worker/Yeshua.Clinica.CQRS.Infrastructure.Worker.csproj",
          "BuildContext": ".",
          "Dockerfile": "infra/Clinica/Migration/workloads/worker/Dockerfile"
        },
        "Replicas": 1,
        "Requires": [
          "clinica-database",
          "redis01",
          "rabbit01",
          "storage01"
        ],
        "Consumes": [],
        "Produces": [],
        "Configuration": {
          "ASPNETCORE_ENVIRONMENT": "Production",
          "Redis__Host": "redis01",
          "Storage__Providers__Disk__Root": "/storage",
          "Storage__Providers__Disk__BaseUrl": "https://playsis.com.br",
          "Storage__Locations__volatile/ia/transcriptions/input": "Disk",
          "Storage__Locations__volatile/ia/transcriptions/output": "Disk",
          "Storage__Locations__volatile/reports/input": "Disk",
          "Storage__Locations__volatile/reports/output": "Disk",
          "Storage__Locations__persistent/docs/input": "Disk",
          "Storage__Locations__persistent/docs/output": "Disk",
          "RabbitMq__HostName": "rabbit01",
          "RabbitMq__Port": "5672",
          "RabbitMq__VirtualHost": "/",
          "RabbitMq__Exchange": "kiwi.exchange",
          "RabbitMq__Queue": "kiwi.queue",
          "RabbitMq__RoutingKey": "kiwi.routing"
        },
        "Secrets": [
          {
            "Target": "MYCONFIG__READCONECTIONSTRING",
            "Secret": "clinica-database-read-connection"
          },
          {
            "Target": "MYCONFIG__WRITECONECTIONSTRING",
            "Secret": "clinica-database-write-connection"
          },
          {
            "Target": "RabbitMq__Username",
            "Secret": "rabbit01-username"
          },
          {
            "Target": "RabbitMq__Password",
            "Secret": "rabbit01-password"
          }
        ],
        "Ports": [
          {
            "Name": "http",
            "ContainerPort": 7215,
            "Protocol": "Http",
            "Route": "/yworker"
          }
        ],
        "Mounts": [
          {
            "Resource": "storage01",
            "MountPath": "/storage",
            "ReadOnly": false
          }
        ],
        "HealthCheck": {
          "Kind": "Tcp",
          "Port": "http",
          "Command": [],
          "IntervalSeconds": 30,
          "TimeoutSeconds": 5,
          "Retries": 3
        }
      }
    },
    {
      "Application": "Clinica",
      "Workload": {
        "Name": "migration",
        "Identity": "clinica-migration",
        "Mode": "Job",
        "Source": {
          "Kind": "Project",
          "ProjectPath": "src/Studio/Yeshua.Studio.AppClinicas/Yeshua.Studio.AppClinicas.csproj",
          "BuildContext": ".",
          "Dockerfile": "infra/Clinica/Migration/workloads/migration/Dockerfile"
        },
        "Replicas": 1,
        "Requires": [
          "clinica-database"
        ],
        "Consumes": [],
        "Produces": [],
        "Configuration": {},
        "Secrets": [
          {
            "Target": "MYCONFIG__READCONECTIONSTRING",
            "Secret": "clinica-database-read-connection"
          },
          {
            "Target": "MYCONFIG__WRITECONECTIONSTRING",
            "Secret": "clinica-database-write-connection"
          }
        ],
        "Ports": [],
        "Mounts": []
      }
    },
    {
      "Application": "Clinica",
      "Workload": {
        "Name": "ai-worker",
        "Identity": "clinica-ai-worker",
        "Mode": "Service",
        "Source": {
          "Kind": "BuildContext",
          "BuildContext": "infra/docker/ai-worker",
          "Dockerfile": "Dockerfile"
        },
        "Replicas": 1,
        "Requires": [
          "rabbit01"
        ],
        "Consumes": [
          "audio.transcribe.outbox"
        ],
        "Produces": [
          "audio.transcribed.inbox"
        ],
        "Configuration": {},
        "Secrets": [
          {
            "Target": "CELERY_BROKER_URL",
            "Secret": "rabbit01-celery-url"
          }
        ],
        "Ports": [],
        "Mounts": [],
        "Compute": {
          "CpuRequest": "500m",
          "CpuLimit": "4",
          "MemoryRequest": "2Gi",
          "MemoryLimit": "8Gi"
        }
      }
    },
    {
      "Application": "Clinica",
      "Workload": {
        "Name": "ai-summarizer",
        "Identity": "clinica-ai-summarizer",
        "Mode": "Service",
        "Source": {
          "Kind": "BuildContext",
          "BuildContext": "infra/docker/ai-summarizer",
          "Dockerfile": "Dockerfile"
        },
        "Replicas": 1,
        "Requires": [
          "rabbit01"
        ],
        "Consumes": [
          "text.summarize.outbox"
        ],
        "Produces": [
          "text.summarized.inbox"
        ],
        "Configuration": {
          "SUMMARIZER_MODEL": "Qwen/Qwen2.5-0.5B-Instruct",
          "SUMMARIZER_DEVICE": "cpu"
        },
        "Secrets": [
          {
            "Target": "CELERY_BROKER_URL",
            "Secret": "rabbit01-celery-url"
          }
        ],
        "Ports": [],
        "Mounts": [],
        "Compute": {
          "CpuRequest": "500m",
          "CpuLimit": "4",
          "MemoryRequest": "2Gi",
          "MemoryLimit": "8Gi"
        }
      }
    },
    {
      "Application": "Fiscal.MDFe",
      "Workload": {
        "Name": "api",
        "Identity": "fiscal-mdfe-api",
        "Mode": "Service",
        "Source": {
          "Kind": "Project",
          "ProjectPath": "src/CQRS/Infrastructure/Yeshua.Fiscal.MDFe.CQRS.Infrastructure.Api/Yeshua.Fiscal.MDFe.CQRS.Infrastructure.Api.csproj",
          "BuildContext": ".",
          "Dockerfile": "infra/Fiscal.MDFe/Migration/workloads/api/Dockerfile"
        },
        "Replicas": 1,
        "Requires": [
          "fiscal-mdfe-database"
        ],
        "Consumes": [],
        "Produces": [],
        "Configuration": {
          "ASPNETCORE_ENVIRONMENT": "Production"
        },
        "Secrets": [
          {
            "Target": "MYCONFIG__READCONECTIONSTRING",
            "Secret": "mdfe-database-read-connection"
          },
          {
            "Target": "MYCONFIG__WRITECONECTIONSTRING",
            "Secret": "mdfe-database-write-connection"
          }
        ],
        "Ports": [
          {
            "Name": "http",
            "ContainerPort": 7214,
            "Protocol": "Http",
            "Route": "/mdfe/yapi",
            "UpstreamRoute": "/yapi"
          }
        ],
        "Mounts": [],
        "HealthCheck": {
          "Kind": "Tcp",
          "Port": "http",
          "Command": [],
          "IntervalSeconds": 30,
          "TimeoutSeconds": 5,
          "Retries": 3
        }
      }
    },
    {
      "Application": "Fiscal.MDFe",
      "Workload": {
        "Name": "front",
        "Identity": "fiscal-mdfe-front",
        "Mode": "Service",
        "Source": {
          "Kind": "Project",
          "ProjectPath": "src/CQRS/Infrastructure/Yeshua.Fiscal.MDFe.CQRS.Infrastructure.Front/Yeshua.Fiscal.MDFe.CQRS.Infrastructure.Front.csproj",
          "BuildContext": ".",
          "Dockerfile": "infra/Fiscal.MDFe/Migration/workloads/front/Dockerfile"
        },
        "Replicas": 1,
        "Requires": [
          "fiscal-mdfe-api"
        ],
        "Consumes": [],
        "Produces": [],
        "Configuration": {
          "ASPNETCORE_ENVIRONMENT": "Production"
        },
        "Secrets": [],
        "Ports": [
          {
            "Name": "http",
            "ContainerPort": 8080,
            "Protocol": "Http",
            "Route": "/mdfe",
            "UpstreamRoute": "/"
          }
        ],
        "Mounts": [],
        "HealthCheck": {
          "Kind": "Tcp",
          "Port": "http",
          "Command": [],
          "IntervalSeconds": 30,
          "TimeoutSeconds": 5,
          "Retries": 3
        }
      }
    },
    {
      "Application": "Fiscal.MDFe",
      "Workload": {
        "Name": "migration",
        "Identity": "fiscal-mdfe-migration",
        "Mode": "Job",
        "Source": {
          "Kind": "Project",
          "ProjectPath": "src/Studio/Yeshua.Studio.Fiscal.MDFe/Yeshua.Studio.Fiscal.MDFe.csproj",
          "BuildContext": ".",
          "Dockerfile": "infra/Fiscal.MDFe/Migration/workloads/migration/Dockerfile"
        },
        "Replicas": 1,
        "Requires": [
          "fiscal-mdfe-database"
        ],
        "Consumes": [],
        "Produces": [],
        "Configuration": {},
        "Secrets": [
          {
            "Target": "MYCONFIG__READCONECTIONSTRING",
            "Secret": "mdfe-database-read-connection"
          },
          {
            "Target": "MYCONFIG__WRITECONECTIONSTRING",
            "Secret": "mdfe-database-write-connection"
          }
        ],
        "Ports": [],
        "Mounts": []
      }
    }
  ],
  "StaticRoutes": [
    {
      "Resource": "storage01",
      "Route": "/volatile/",
      "ResourcePath": "/storage/volatile/"
    }
  ]
}