[Unit]
Description=Yeshua backup controller (%i)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
Nice=19
IOSchedulingClass=idle
CPUQuota=25%
MemoryMax=256M
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 -I /opt/yeshua-backup/current/infra/backups/control.py controller --kind %i
TimeoutStartSec=3min
