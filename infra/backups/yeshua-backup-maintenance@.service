[Unit]
Description=Yeshua storage repository verification (%i)

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
Nice=19
IOSchedulingClass=idle
CPUQuota=25%
MemoryMax=768M
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=GOMEMLIMIT=384MiB
ExecStart=/usr/bin/python3 -I /opt/yeshua-backup/current/infra/backups/control.py maintenance --request %i
TimeoutStartSec=12h
KillMode=control-group
