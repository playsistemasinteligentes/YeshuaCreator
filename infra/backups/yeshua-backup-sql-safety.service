[Unit]
Description=Yeshua local SQL log safety when controller is unavailable
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
Nice=19
IOSchedulingClass=idle
CPUQuota=25%
MemoryMax=768M
Environment=YESHUA_APP_DIR=/root/YeshuaCreator
Environment=PYTHONDONTWRITEBYTECODE=1
WorkingDirectory=/root/YeshuaCreator
ExecStart=/usr/bin/python3 -I /opt/yeshua-backup/current/infra/backups/control.py sql-safety
TimeoutStartSec=4h
KillMode=control-group
