location = /apps/presenca/yapi {
    return 301 /apps/presenca/yapi/;
}

location /apps/presenca/yapi/ {
    rewrite ^/apps/presenca/yapi/(.*)$ /yapi/$1 break;
    proxy_pass http://presenca_api_pool;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Prefix /apps/presenca/yapi;
}

location = /apps/presenca/yworker/health/live {
    proxy_pass http://presenca_worker_pool/yapi/health/live;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
}
