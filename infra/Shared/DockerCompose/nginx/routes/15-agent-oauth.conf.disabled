# Enable only with an explicitly configured/provisioned Central AgentOAuth
# profile in the approved environment. Does not alter /operational/mcp.
location ~ ^/(oauth/(authorize|token|revoke)|\.well-known/(oauth-authorization-server|openid-configuration|jwks|oauth-protected-resource/business/mcp)|business/mcp)$ {
    proxy_pass http://central_api_pool;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_buffering off;
    proxy_read_timeout 60s;
    client_max_body_size 128k;
}
