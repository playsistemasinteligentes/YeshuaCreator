        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "definition": "label_values({__name__=~\"yeshua_operation_executions(_execution)?(_total)?\", deployment_environment_name=~\"$environment\"}, service_name)",
        "includeAll": true,
        "label": "Servico",
        "multi": true,
        "name": "service",
        "options": [],
        "query": { "query": "label_values({__name__=~\"yeshua_operation_executions(_execution)?(_total)?\", deployment_environment_name=~\"$environment\"}, service_name)", "refId": "VariableQueryEditor-Service" },
        "refresh": 2,
        "regex": "",
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "time": { "from": "now-6h", "to": "now" },
