      },
      { "current": { "text": "", "value": "" }, "label": "Fila", "name": "queue", "options": [], "query": "", "type": "textbox" },
      { "current": { "text": "", "value": "" }, "label": "Tenant", "name": "tenant", "options": [], "query": "", "type": "textbox" },
      { "current": { "text": "", "value": "" }, "label": "Item", "name": "item", "options": [], "query": "", "type": "textbox" },
