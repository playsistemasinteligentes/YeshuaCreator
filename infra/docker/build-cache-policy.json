      "minFreeSpace": "30000000000"
    },
    {
      "reservedSpace": "10000000000",
      "maxUsedSpace": "30000000000",
      "minFreeSpace": "30000000000"
    },
    {
      "all": true,
      "reservedSpace": "10000000000",
      "maxUsedSpace": "30000000000",
      "minFreeSpace": "30000000000"
    }
  ]
}
