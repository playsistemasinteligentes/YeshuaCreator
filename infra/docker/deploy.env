# Nomes dos bancos usados pelos containers e pelas migrations.
# Altere somente este arquivo quando uma instalacao precisar nascer em bancos novos.
YESHUA_DB_CENTRAL=YESHUA_CENTRAL
YESHUA_DB_CLINICA=YESHUA_CLINICA
YESHUA_DB_APS_ADM=YESHUA_APS_ADM
YESHUA_DB_FISCAL=YESHUA_FISCAL
YESHUA_DB_OPERATIONAL_INTELLIGENCE=YESHUA_OPERATIONAL_INTELLIGENCE

# ConsoleJsonl mantem a saida local no Docker. Otlp envia para o pacote yeshua-telemetry.
YESHUA_TELEMETRY_EXPORT_MODE=ConsoleJsonl
YESHUA_TELEMETRY_OTLP_ENDPOINT=http://yeshua-telemetry:4317
