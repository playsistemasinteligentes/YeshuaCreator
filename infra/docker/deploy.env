# Nomes publicos dos bancos. As conexoes efetivas ficam no credentials.json privado.
# Ao renomear bancos, ajuste explicitamente as conexoes privadas correspondentes.
# O deploy nao reescreve conexoes nem migra dados com base nestes nomes.
YESHUA_DB_CENTRAL=YESHUA_CENTRAL
YESHUA_DB_CLINICA=YESHUA_CLINICA
YESHUA_DB_APS_ADM=YESHUA_APS_ADM
YESHUA_DB_FISCAL=YESHUA_FISCAL
YESHUA_DB_MEMORIAS=YESHUA_MEMORIAS
YESHUA_DB_OPERATIONAL_INTELLIGENCE=YESHUA_OPERATIONAL_INTELLIGENCE

# Deploy de servidor envia para o pacote yeshua-observability. Execucao local sem esta variavel continua ConsoleJsonl.
YESHUA_TELEMETRY_EXPORT_MODE=Otlp
YESHUA_TELEMETRY_OTLP_ENDPOINT=http://yeshua-observability:4317
